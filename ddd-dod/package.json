{
  "name": "ddd-dod",
  "version": "0.1.0",
  "description": "Data-Oriented Design implementation for the dod-vs-oop comparative study",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*", "packages/modules/*"],
  "scripts": {
    "dev": "bun --watch apps/api/src/main.ts",
    "start": "bun apps/api/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "clean": "rm -rf node_modules **/node_modules **/dist .tsbuildinfo **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@ddd-dod/types": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.3"
  }
}
